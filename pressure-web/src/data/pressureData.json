  "methodology": [
    {
      "id": "data-cleaning",
      "title": "1. Data Scope & Calibrated Extras",
      "summary": "788 non-DLS matches (357 IPL, 431 T20I, 2022–2026), 188,151 deliveries with empirical extras runs calibration.",
      "details": "Legal balls require extras_type not in {'wide', 'Overstep', 'other'}. Calibrated runs from a 392-match regression: wide = 1.15 runs, no-ball = 1.0 + bat_runs, other = 1.3, byes = 2.1, leg-byes = 1.3. Bowlers are charged bat_runs + wide_runs + no-ball penalties (byes/leg-byes excluded). Only bowler-credited dismissals count for bowling wickets."
    },
    {
      "id": "wp-model",
      "title": "2. Cross-Fitted Win-Probability Models",
      "summary": "Out-of-fold logistic regression models achieving log-loss 0.636 (Innings 1) and 0.402 (Innings 2).",
      "details": "Innings 1 uses logistic regression on [runs_before, balls_left, wickets_before, is_ipl]. Innings 2 uses standard scaling, second-degree polynomial interactions, and L2 regularization (C=0.03) on [runs_needed, balls_left, wickets_before, target, is_ipl, required_rate_capped_36]. Cross-fitted out-of-fold using 5-fold match grouping to prevent data leakage."
    },
    {
      "id": "pressure-index",
      "title": "3. Pressure Index Formula",
      "summary": "Expected absolute win-probability swing across 9 possible outcomes on the next delivery.",
      "details": "Formula: Pressure Index = sum_{k=1}^9 P(outcome_k | match context) * |Delta WP_k|. Context includes league (IPL vs T20I), innings (1 vs 2), phase (Overs 1–6, 7–15, 16–20), and wickets in hand. High-pressure flag identifies the top 20% of deliveries within each context (~37,600 balls)."
    },
    {
      "id": "residuals",
      "title": "4. Performance Residuals & Attribution",
      "summary": "Win probability added above context expectation, normalized to percentage points per 100 balls.",
      "details": "Every ball produces a residual: Actual WP change minus context expected WP change. Opponent adjustment adds the opponent's shrunk all-ball average residual to reward players who face stronger adversaries."
    },
    {
      "id": "shrinkage",
      "title": "5. Composite Score & Empirical-Bayes Shrinkage",
      "summary": "DerSimonian-Laird random-effects shrinkage with match-level cluster-robust variance.",
      "details": "To prevent small samples from dominating the leaderboard (e.g., Rinku Singh's 166.6 raw rating), DerSimonian-Laird shrinkage pulls noisy estimates toward the cohort prior. The composite score weights: 50% Shrunk HP Rating (A), 25% Shrunk Uplift (B), and 25% Shrunk Consistency (C), averaged across 4 pressure cutoffs (top 30%, 25%, 20%, 15%)."
    },
    {
      "id": "ipl-t20i-fairness",
      "title": "6. IPL vs. T20I Sample Fairness & Reliability",
      "summary": "Protection against micro-sample bias and correction of competitive context differences.",
      "details": "Single-competition samples under 25 HP balls are explicitly flagged or blanked. Split-half reliability in T20 cricket is approximately 0.12 raw and 0.21 shrunk for batters, demonstrating why point estimates must always be reported alongside bootstrap confidence intervals."
    }
  ],
  "limitations": [
    "Estimated extras: Extras runs missing in the raw feed are estimated from empirical margin regression (wide: 1.15, no-ball: 1.0 + bat runs, bye: 2.1, leg-bye: 1.3).",
    "No venue or pitch data: Boundary dimensions, dew factor, weather, and pitch deterioration are not recorded in the ball-by-ball feed.",
    "Situational pressure only: Quantifies scoreboard leverage and win-probability volatility, not biological heart rate or psychological stress.",
    "Run-outs not credited to bowlers: Bowler wickets strictly include bowled, caught, lbw, stumped, and hit-wicket only.",
    "T20I opposition quality varies: Opponent shrinkage accounts for this, but variance remains across different international fixtures.",
